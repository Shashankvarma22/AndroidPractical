<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/ivItemPoster"
        android:layout_width="60dp"
        android:layout_height="85dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/cd_movie_poster"
        android:background="#E0E0E0" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvItemYearType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_year"
            android:textSize="13sp"
            android:textColor="#555555"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/tvItemImdbId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_imdb_id"
            android:textSize="12sp"
            android:textColor="#888888"
            android:paddingTop="2dp" />

    </LinearLayout>

</LinearLayout>