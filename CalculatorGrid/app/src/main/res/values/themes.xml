<resources>
    <style name="Base.Theme.CalculatorGrid" parent="Theme.Material3.DayNight.NoActionBar" />
    <style name="Theme.CalculatorGrid" parent="Base.Theme.CalculatorGrid" />

    <style name="CalcButton" parent="android:Widget.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/btn_flat_bg</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="KeypadButton" parent="CalcButton">
        <item name="android:textSize">18sp</item>
        <item name="android:backgroundTint">@color/calc_key_white</item>
    </style>

    <style name="GreyButton" parent="CalcButton">
        <item name="android:backgroundTint">@color/calc_key_grey</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="BlueButton" parent="CalcButton">
        <item name="android:backgroundTint">@color/calc_blue</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="PurpleButton" parent="CalcButton">
        <item name="android:backgroundTint">@color/calc_purple</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="RedButton" parent="CalcButton">
        <item name="android:backgroundTint">@color/calc_red</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="OrangeButton" parent="CalcButton">
        <item name="android:backgroundTint">@color/calc_orange</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="TealButton" parent="CalcButton">
        <item name="android:backgroundTint">@color/calc_cyan</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">10sp</item>
    </style>
</resources>